/* BENCHMARK: a hot nested loop (3,000 iterations of the inner body)
 * Expected output: 781500  10
 *
 * Used by benchmarks/measure.sh to compare optimized and unoptimized code.
 * The inner body is written the way generated or careless code often looks:
 * multiplications by 1, additions of 0, and arithmetic on literals.  The
 * optimizer can clean all of that up INSIDE the loop, where every instruction
 * saved is saved 3,000 times.  `scale` is straight-line setup outside the
 * loop, where a saved instruction is saved only once.
 *
 *   k = (i*1 + 0) * (2*4)        = 8i
 *   s = s + k + j*1 + (3*3 - 9)  adds 8i + j
 *   sum over i = 0..59, j = 0..49:  50 * 8 * (0+...+59) + 60 * (0+...+49)
 *                                 = 708000 + 73500 = 781500 */
int main() {
    int i;
    int j;
    int k;
    int s;
    int scale;
    scale = 2 * 3 + 4;
    s = 0;
    for (i = 0; i < 60; i = i + 1) {
        for (j = 0; j < 50; j = j + 1) {
            k = (i * 1 + 0) * (2 * 4);
            s = s + k + j * 1 + (3 * 3 - 9);
        }
    }
    print(s);
    print(scale);
    return 0;
}
