/* Expected output: 1  0  14  2  1  0  7  1  0  -1
 * The full precedence table, lowest to highest:
 *   == !=   then   < > <= >=   then   + -   then   * /   then   unary -
 * Every line differs if the precedence is wrong.  Values come from
 * parameters, so the machine really computes them.  a=2, b=3, c=4:
 *   a + 1 < b * 2       (a+1) < (b*2)   = 3 < 6        = 1  (wrong: a+(1<b)*2 = 4)
 *   a * b < a + b       6 < 5                          = 0
 *   a + b * c           2 + 12                          = 14 (wrong: 20)
 *   c - a - 0 * b       (4-2) - (0*3)                   = 2
 *   a < b == b < c      (2<3) == (3<4)  = 1 == 1        = 1  (wrong: 0)
 *   c / a > b           (4/2) > 3       = 2 > 3         = 0
 *   -a + 9              (-2) + 9                        = 7  (wrong: -11)
 *   b - a == 1          (3-2) == 1                      = 1  (wrong: 0)
 *   a == b - 1 > c      a == ((b-1) > c) = 2 == 0       = 0
 *   -a * b / c          ((-2)*3)/4 = -6/4               = -1 */
int show(int a, int b, int c) {
    print(a + 1 < b * 2);
    print(a * b < a + b);
    print(a + b * c);
    print(c - a - 0 * b);
    print(a < b == b < c);
    print(c / a > b);
    print(-a + 9);
    print(b - a == 1);
    print(a == b - 1 > c);
    print(-a * b / c);
    return 0;
}

int main() {
    show(2, 3, 4);
    return 0;
}
