/* Expected output: 14  20  9  -6  -6  -2
 * The six expressions from class activity 1 (Precedence Lab).
 * -8 / 2 / 2 is ((-8) / 2) / 2 = -2.  Unary minus binds tightest. */
int main() {
    print(2 + 3 * 4);
    print((2 + 3) * 4);
    print(17 - 5 - 3);
    print(-2 * 3);
    print(2 * -3);
    print(-8 / 2 / 2);
    return 0;
}
