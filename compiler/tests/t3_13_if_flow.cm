/* Expected output: 1  2  3  3  1  0  1  0  1  1  5
 * if/else, which recursion needs, and the jumps it gives the flow optimizer.
 *   grade(95)=1, grade(75)=2, grade(40)=3.
 *   The dangling else binds to the nearest if: dangling(5) = 3.
 *   Each comparison operator yields exactly 1 or 0.
 *   `if (1)` and `if (2 > 3)` have constant conditions: branch simplification
 *   and unreachable-code removal delete the branch that cannot run, and the
 *   print(777) below disappears from the generated assembly altogether. */
int grade(int n) {
    if (n >= 90) {
        return 1;
    } else {
        if (n >= 70) {
            return 2;
        }
    }
    return 3;
}

int dangling(int n) {
    int r;
    r = 0;
    if (n > 0)
        if (n > 10)
            r = 1;
        else
            r = 3;
    return r;
}

int cmp(int a, int b) {
    print(a < b);
    print(a > b);
    print(a <= b);
    print(a >= b);
    print(a == a);
    print(a != b);
    return 0;
}

int main() {
    print(grade(95));
    print(grade(75));
    print(grade(40));
    print(dangling(5));
    cmp(1, 2);
    if (2 > 3) {
        print(777);
    } else {
        print(5);
    }
    if (1) {
    } else {
        print(777);
    }
    return 0;
}
