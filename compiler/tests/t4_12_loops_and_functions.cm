/* Expected output: 3628800  55  4  -1  30  120
 * Loops combined with functions, recursion and arrays.
 *   factorial written with a loop: 10! = 3628800
 *   fibonacci written with a loop: fib(10) = 55
 *   a return from INSIDE a loop leaves the loop and the function:
 *     find returns the index of 9 in {5, 3, 7, 1, 9}: 4,  and -1 when absent
 *   a loop over an array passed by reference: 2+4+6+8+10 = 30
 *   a loop that calls a recursive function each time round: times(p, i)
 *     multiplies by repeated addition, giving 1 * 2 * 3 * 4 * 5 = 120 */
int fact(int n) {
    int r;
    int i;
    r = 1;
    for (i = 2; i <= n; i = i + 1) r = r * i;
    return r;
}

int fib(int n) {
    int a;
    int b;
    int t;
    int i;
    a = 0;
    b = 1;
    for (i = 0; i < n; i = i + 1) {
        t = a + b;
        a = b;
        b = t;
    }
    return a;
}

int find(int a[], int n, int want) {
    int i;
    i = 0;
    while (i < n) {
        if (a[i] == want) return i;
        i = i + 1;
    }
    return -1;
}

int sum(int a[], int n) {
    int i;
    int s;
    s = 0;
    for (i = 0; i < n; i = i + 1) s = s + a[i];
    return s;
}

int times(int a, int b) {
    if (b == 0) return 0;
    return a + times(a, b - 1);
}

int main() {
    int d[5];
    int i;
    int p;
    d[0] = 5; d[1] = 3; d[2] = 7; d[3] = 1; d[4] = 9;
    print(fact(10));
    print(fib(10));
    print(find(d, 5, 9));
    print(find(d, 5, 4));
    for (i = 0; i < 5; i = i + 1) d[i] = (i + 1) * 2;
    print(sum(d, 5));
    p = 1;
    for (i = 1; i <= 5; i = i + 1) p = times(p, i);
    print(p);
    return 0;
}
