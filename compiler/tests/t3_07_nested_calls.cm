/* Expected output: 21  12  14  23  30
 * Nested calls, in every position.  The required pair is f(1, g(2)) and
 * f(g(1), 2).  sub is not commutative, so it also proves that the arguments
 * arrive in the right order.
 *   g(x) = x * 10          f(a, b) = a + b          sub(a, b) = a - b
 *   f(1, g(2))             = 1 + 20                 = 21
 *   f(g(1), 2)             = 10 + 2                 = 12
 *   sub(g(2), f(3, 3))     = 20 - 6                 = 14
 *   f(f(1, 2), f(sub(30, 10), 0)) = 3 + 20          = 23
 *   a local survives a call: x = 10; f(x, g(x) + x) - x - 80 = 30 */
int g(int x) { return x * 10; }
int f(int a, int b) { return a + b; }
int sub(int a, int b) { return a - b; }

int main() {
    int x;
    x = 10;
    print(f(1, g(2)));
    print(f(g(1), 2));
    print(sub(g(2), f(3, 3)));
    print(f(f(1, 2), f(sub(30, 10), 0)));
    print(f(x, g(x) + x) - x - 80);
    return 0;
}
