/* Expected output: 120  720  55  1  0
 * Recursion, the minimum bar for a working calling convention.
 * fact(5) = 120 and fact(6) = 720.  fib(10) = 55 makes TWO recursive calls in
 * one expression, so the first result has to survive the second call in this
 * activation's frame.  isEven and isOdd call each other, so one of them is
 * always called above its definition: isEven(10) = 1, isEven(7) = 0. */
int fact(int n) {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}

int fib(int n) {
    if (n < 2) return n;
    return fib(n - 1) + fib(n - 2);
}

int isEven(int n) {
    if (n == 0) return 1;
    return isOdd(n - 1);
}

int isOdd(int n) {
    if (n == 0) return 0;
    return isEven(n - 1);
}

int main() {
    print(fact(5));
    print(fact(6));
    print(fib(10));
    print(isEven(10));
    print(isEven(7));
    return 0;
}
