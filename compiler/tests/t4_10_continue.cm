/* Expected output: 25  6  12  9
 * continue (an optional extension) skips to the next iteration.
 *   while: sums the odd numbers 1..9  = 25.  continue must re-test the
 *          condition, and the counter is advanced BEFORE the continue.
 *   for:   counts i = 0..9, skipping multiples of 3 (0, 3, 6, 9): 6.
 *          continue in a for must still run the UPDATE, or i never advances
 *          and the loop never ends.
 *   for:   sums 2 + 4 + 6 = 12 by skipping the odd values of i.
 *   nested: continue in the inner loop only affects the inner loop: 9 */
int main() {
    int i;
    int j;
    int s;
    int c;
    s = 0;
    i = 0;
    while (i < 10) {
        i = i + 1;
        if (i / 2 * 2 == i) continue;
        s = s + i;
    }
    print(s);
    c = 0;
    for (i = 0; i < 10; i = i + 1) {
        if (i / 3 * 3 == i) continue;
        c = c + 1;
    }
    print(c);
    s = 0;
    for (i = 1; i <= 6; i = i + 1) {
        if (i / 2 * 2 != i) continue;
        s = s + i;
    }
    print(s);
    c = 0;
    for (i = 0; i < 3; i = i + 1) {
        for (j = 0; j < 4; j = j + 1) {
            if (j == 1) continue;
            c = c + 1;
        }
    }
    print(c);
    return 0;
}
